# Copy this file to `.env` and uncomment what you need. Every variable is optional.

# Show draft content in local or preview builds (docs/data.md). Never in Production.
# VITE_SHOW_DRAFTS="true"

# Coming-soon gate (see docs/architecture.md#coming-soon-gate). Also stops the build writing the agent files.
# COMING_SOON="true"

# The origin the agent copies link to (docs/decisions/0021-agent-copies-and-agent-view.md).
# VITE_SITE_URL="https://portfolio.wends.dev"
